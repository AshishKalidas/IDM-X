{
  "manifest_version": 3,
  "name": "IDMX \u2014 grab downloads, video & torrents",
  "version": "0.2.0",
  "description": "Send links and downloads to the IDMX app, with your logged-in cookies, so every network you have pulls them at once.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "IDMX",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "sniff.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}