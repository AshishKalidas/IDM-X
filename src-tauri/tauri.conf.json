{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDMX",
  "version": "0.2.1",
  "identifier": "app.idmx.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "IDMX",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Download faster by using every network at once",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "fileAssociations": [{ "ext": ["torrent"], "mimeType": "application/x-bittorrent", "name": "BitTorrent file", "role": "Viewer" }]
  }
}
